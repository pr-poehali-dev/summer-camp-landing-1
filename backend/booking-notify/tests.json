{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Notify booking with early start",
      "method": "POST",
      "path": "/",
      "body": {
        "mother_name": "Анна Тест",
        "phone": "+7 (999) 123-45-67",
        "child_name": "Миша",
        "age": "9",
        "email": "test@example.com",
        "shift_id": 3,
        "shift_name": "Мульти-драйв",
        "early_start": true,
        "stage": "submit"
      },
      "expectedStatus": 200,
      "expectedBody": {"ok": true, "stage": "submit"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Notify abandoned form (partial fill)",
      "method": "POST",
      "path": "/",
      "body": {
        "mother_name": "Ольга",
        "phone": "+7 (999) 555-44-33",
        "child_name": "",
        "age": "",
        "email": "",
        "shift_id": 1,
        "shift_name": "Сундук со сказками",
        "early_start": false,
        "stage": "abandoned"
      },
      "expectedStatus": 200,
      "expectedBody": {"ok": true, "stage": "abandoned"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Notify booking with friend",
      "method": "POST",
      "path": "/",
      "body": {
        "mother_name": "Елена Тест",
        "phone": "+7 (999) 222-33-44",
        "child_name": "Маша",
        "age": "10",
        "email": "test2@example.com",
        "shift_id": 2,
        "shift_name": "Море и творчество",
        "early_start": false,
        "with_friend": true,
        "friend_name": "Иван Петров",
        "stage": "submit"
      },
      "expectedStatus": 200,
      "expectedBody": {"ok": true, "stage": "submit"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Reject submit when no name",
      "method": "POST",
      "path": "/",
      "body": {"phone": "+79991234567", "stage": "submit"},
      "expectedStatus": 400
    },
    {
      "name": "Reject empty abandoned form",
      "method": "POST",
      "path": "/",
      "body": {"stage": "abandoned"},
      "expectedStatus": 400
    }
  ]
}